rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function matchDoc(matchId) {
      return get(/databases/$(database)/documents/matches/$(matchId)).data;
    }

    function isMatchPlayer(matchId) {
      return signedIn() && request.auth.uid in matchDoc(matchId).playerIds;
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.username is string
        && request.resource.data.usernameLower is string;
      allow update: if signedIn() && request.auth.uid == userId;
      allow delete: if false;
    }

    match /usernames/{usernameLower} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email']);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /fcmTokens/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.hostId == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.hostId == request.auth.uid;
    }

    match /matches/{matchId} {
      allow read: if signedIn() && request.auth.uid in resource.data.playerIds;
      allow create: if signedIn()
        && request.resource.data.hostId == request.auth.uid
        && request.auth.uid in request.resource.data.playerIds;
      allow update: if signedIn() && (
        (request.auth.uid == resource.data.hostId && request.resource.data.hostId == resource.data.hostId)
        || (
          resource.data.status == 'lobby'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['playerIds'])
          && request.resource.data.playerIds.hasAll(resource.data.playerIds)
          && request.auth.uid in request.resource.data.playerIds
        )
      );
      allow delete: if false;

      match /players/{playerId} {
        allow read: if isMatchPlayer(matchId);
        allow create: if signedIn() && request.auth.uid == playerId
          && matchDoc(matchId).status == 'lobby';
        allow update, delete: if false;
      }

      match /scores/{playerId} {
        allow read: if isMatchPlayer(matchId);
        allow create: if signedIn()
          && request.auth.uid == playerId
          && request.auth.uid in matchDoc(matchId).playerIds
          && matchDoc(matchId).status in ['lobby', 'playing'];
        allow update: if signedIn()
          && request.auth.uid == playerId
          && request.auth.uid in matchDoc(matchId).playerIds
          && matchDoc(matchId).status == 'playing';
        allow delete: if false;
      }
    }

    match /games/{gameId} {
      allow read: if signedIn() && request.auth.uid == resource.data.userId;
      allow create: if signedIn() && request.auth.uid == request.resource.data.userId;
      allow update, delete: if false;
    }
  }
}
